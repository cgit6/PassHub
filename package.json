{
  "name": "passhub",
  "version": "0.1.0",
  "private": true,
  "description": "PassHub access-decision API sandbox",
  "license": "UNLICENSED",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./composition": {
      "types": "./dist/src/composition/index.d.ts",
      "require": "./dist/src/composition/index.js",
      "default": "./dist/src/composition/index.js"
    }
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "test:unit": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:integration": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.cjs",
    "test:g04a": "node scripts/test-g04a-integration.mjs",
    "test:coverage": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --coverage",
    "test:boundary": "npm run build && node scripts/check-g03c-boundary.mjs",
    "test:negative-compile": "npm run build && node scripts/check-g03c-negative-compile.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.6",
    "jest": "30.5.2",
    "typescript": "5.9.3"
  }
}
